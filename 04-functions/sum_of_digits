#include<iostream>
using namespace std;

int sumOfDigits(int number){
	
	int sum = 0;
	
	while(number != 0){
		int lastDigit = number % 10;
		number = number / 10;
		sum = sum + lastDigit;
		
		}
		return sum;
}
int main(){
	int number = 0;
	
	cout << "== Continuous Digit Sum Calculation ==\n";
	while(true){
	cout << "\nEnter a whole number or(press -1 to exit) : \n";
	cin >> number;
	
	if(number == -1){
		cout << "Thank you for using the sum calculator. Goodbye!\n";
		break;
	}

	cout << "Sum of the whole number is : " << sumOfDigits(number);
}
	return 0;
}
