#include<iostream>
using namespace std;

int sumOfDigits(int number){
	
	int sum = 0;
	
	while(number != 0){
		int lastDigit = number % 10;
		number = number / 10;
		sum = sum + lastDigit;
		
		}
		return sum;
}
int main(){
	int number;
	cout << "Enter a whole number : ";
	cin >> number;
	
	cout << "Sum of the whole number is : " << sumOfDigits(number);
	return 0;
}
