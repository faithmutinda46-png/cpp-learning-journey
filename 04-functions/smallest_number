#include <iostream>
using namespace std;

// Find the smallest number in the array.
int findSmallest(int numbers[5]){

    // Start with the first number as the smallest.
	int smallest = numbers[0];
	
	for(int i = 0; i < 5; i++){
		if(numbers[i < smallest]){
			smallest = numbers[i];
		}
	}
	return smallest;
	
}
int main(){
	
	int numbers[5];
	
	cout << "Enter numbers : \n";
	
	for(int i = 0; i < 5; i++){
	
	cin >> numbers[i];
}

	cout << findSmallest(numbers) << " is the smallest number.";
	return 0;

}
