#include <iostream>
using namespace std;

// Find the smallest number in the array.
int findSmallest(int numbers[5]){

    // Start with the first number as the smallest.
	int smallest = numbers[0];

    // Check each number and update smallest when a smaller number is found.
	for(int i = 0; i < 5; i++){
		if(numbers[i < smallest]){
			smallest = numbers[i];
		}
	}
    // Return the smallest number.
	return smallest;
	
}
int main(){
	
	int numbers[5];

    // Ask the user to enter 5 numbers.
	cout << "Enter numbers : \n";

    // Store the user's numbers in the array.
	for(int i = 0; i < 5; i++){
	
	cin >> numbers[i];
}
    // Display the smallest number found.
	cout << findSmallest(numbers) << " is the smallest number.";
	return 0;

}
